{
  "name": "context-bridge",
  "repository": "https://github.com/kirillnst/context-bridge.git",
  "homepage": "https://github.com/kirillnst/context-bridge#readme",
  "bugs": {
    "url": "https://github.com/kirillnst/context-bridge/issues"
  },
  "displayName": "Context Bridge",
  "publisher": "kirillnst",
  "description": "Build workspace context selections for LLM prompts and apply structured patch responses back to the project.",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "preview": false,
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "llm",
    "ai coding",
    "coding assistant",
    "context",
    "context management",
    "workspace context",
    "prompt",
    "prompt context",
    "code context",
    "project context",
    "code patch",
    "patch",
    "ai patch",
    "code editing",
    "developer tools",
    "copilot",
    "claude",
    "chatgpt",
    "gemini"
  ],
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "markdown": "github",
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "media/**",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
  "views": {
    "explorer": [
      {
        "id": "contextBridgeExplorer",
        "name": "Context Bridge",
        "icon": "media/view-icon.svg"
      }
    ]
  },
    "viewsWelcome": [
      {
        "view": "contextBridgeExplorer",
        "contents": "Context Bridge is not initialized yet.\n[Initialize](command:context-bridge.initializeWorkspaceFiles)",
        "when": "workspaceFolderCount != 0 && contextBridge.needsInitialization"
      },
      {
        "view": "contextBridgeExplorer",
        "contents": "No selections yet.\n[Create Selection](command:context-bridge.createSelection)",
        "when": "workspaceFolderCount != 0 && contextBridge.hasConfiguration && !contextBridge.needsInitialization"
      },
      {
        "view": "contextBridgeExplorer",
        "contents": "Open a folder or workspace to use Context Bridge.",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "context-bridge.initializeWorkspaceFiles",
        "title": "Initialize Workspace Files",
        "category": "Context Bridge",
        "icon": "$(settings-gear)"
      },
      {
        "command": "context-bridge.createSelection",
        "title": "Create Selection",
        "category": "Context Bridge",
        "icon": "$(add)"
      },
      {
        "command": "context-bridge.exportSelection",
        "title": "Export Selection",
        "category": "Context Bridge",
        "icon": "$(arrow-up)"
      },
      {
        "command": "context-bridge.importSelection",
        "title": "Import Patch",
        "category": "Context Bridge",
        "icon": "$(arrow-down)"
      },
      {
        "command": "context-bridge.activateSelection",
        "title": "Activate Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.deactivateSelection",
        "title": "Deactivate Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.renameSelection",
        "title": "Rename Selection…",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.renameSelectionShort",
        "title": "Rename Short Name…",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.deleteSelection",
        "title": "Delete Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.addToSelection",
        "title": "Add to Selection…",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.removeFromSelection",
        "title": "Remove from Selection…",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.removeSelectionItem",
        "title": "Remove from Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.removeExclusionItem",
        "title": "Remove Exclusion",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.addIgnoredContentExtension",
        "title": "Ignore File Content by Extension",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.removeIgnoredContentExtension",
        "title": "Stop Ignoring File Content by Extension",
        "category": "Context Bridge"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "context-bridge.initializeWorkspaceFiles",
          "when": "view == contextBridgeExplorer && contextBridge.needsInitialization",
          "group": "navigation@1"
        },
        {
          "command": "context-bridge.createSelection",
          "when": "view == contextBridgeExplorer && contextBridge.hasConfiguration",
          "group": "navigation@2"
        },
        {
          "command": "context-bridge.exportSelection",
          "when": "view == contextBridgeExplorer && contextBridge.hasConfiguration",
          "group": "navigation@3"
        },
        {
          "command": "context-bridge.importSelection",
          "when": "view == contextBridgeExplorer && contextBridge.hasConfiguration",
          "group": "navigation@4"
        }
      ],
      "explorer/context": [
        {
          "command": "context-bridge.addToSelection",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge@1"
        },
        {
          "command": "context-bridge.removeFromSelection",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge@2"
        },
        {
          "command": "context-bridge.addIgnoredContentExtension",
          "when": "resourceScheme == file && isFileSystemResource && !explorerResourceIsFolder",
          "group": "7_contextBridge@3"
        },
        {
          "command": "context-bridge.removeIgnoredContentExtension",
          "when": "resourceScheme == file && isFileSystemResource && !explorerResourceIsFolder",
          "group": "7_contextBridge@4"
        }
      ],
      "view/item/context": [
        {
          "command": "context-bridge.createSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.workspaceFolder",
          "group": "1_selection@1"
        },
        {
          "command": "context-bridge.renameSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.active",
          "group": "3_manage@1"
        },
        {
          "command": "context-bridge.renameSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.inactive",
          "group": "3_manage@1"
        },
        {
          "command": "context-bridge.renameSelectionShort",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.active",
          "group": "3_manage@2"
        },
        {
          "command": "context-bridge.renameSelectionShort",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.inactive",
          "group": "3_manage@2"
        },
        {
          "command": "context-bridge.deleteSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.active",
          "group": "3_manage@3"
        },
        {
          "command": "context-bridge.deleteSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.inactive",
          "group": "3_manage@3"
        },
        {
          "command": "context-bridge.removeSelectionItem",
          "when": "view == contextBridgeExplorer && viewItem =~ /^contextBridge\\.selectionItem\\./",
          "group": "3_manage@3"
        },
        {
          "command": "context-bridge.removeExclusionItem",
          "when": "view == contextBridgeExplorer && viewItem =~ /^contextBridge\\.selectionExcludeItem\\./",
          "group": "3_manage@3"
        }
      ]


    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}

