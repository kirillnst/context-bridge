{
  "name": "context-bridge",
  "displayName": "Context Bridge",
  "description": "Build workspace context selections for LLM prompts and apply structured patch responses back to the project.",
  "version": "0.1.0",
  "license": "MIT",
  "preview": true,
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "llm",
    "prompt",
    "context",
    "patch",
    "workspace",
    "developer-tools"
  ],
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "markdown": "github",
  "activationEvents": [
    "onView:contextBridgeExplorer",
    "onCommand:context-bridge.initializeWorkspaceFiles",
    "onCommand:context-bridge.exportSelection",
    "onCommand:context-bridge.importSelection",
    "onCommand:context-bridge.activateSelection",
    "onCommand:context-bridge.deactivateSelection",
    "onCommand:context-bridge.addToSelection",
    "onCommand:context-bridge.removeFromSelection"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "media/**",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SUPPORT.md"
  ],
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "contextBridgeExplorer",
          "name": "Context Bridge"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "contextBridgeExplorer",
        "contents": "Context Bridge is not initialized yet.\n[Create .vscode/context-bridge.json](command:context-bridge.initializeWorkspaceFiles)",
        "when": "workspaceFolderCount != 0"
      },
      {
        "view": "contextBridgeExplorer",
        "contents": "Open a folder or workspace to use Context Bridge.",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "context-bridge.initializeWorkspaceFiles",
        "title": "Context Bridge: Initialize Workspace Files",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.exportSelection",
        "title": "Context Bridge: Export Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.importSelection",
        "title": "Context Bridge: Import Patch",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.activateSelection",
        "title": "Activate Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.deactivateSelection",
        "title": "Deactivate Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.addToSelection",
        "title": "Add to Selection…",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.removeFromSelection",
        "title": "Remove from Selection…",
        "category": "Context Bridge"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "context-bridge.addToSelection",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge@1"
        },
        {
          "command": "context-bridge.removeFromSelection",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge@2"
        }
      ],
      "view/item/context": [
        {
          "command": "context-bridge.activateSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.inactive"
        },
        {
          "command": "context-bridge.deactivateSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.active"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}

