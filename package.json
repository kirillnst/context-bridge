{
  "name": "context-bridge",
  "repository": "https://github.com/kirillnst/context-bridge.git",
  "homepage": "https://github.com/kirillnst/context-bridge#readme",
  "bugs": {
    "url": "https://github.com/kirillnst/context-bridge/issues"
  },
  "displayName": "Context Bridge",
  "publisher": "kirillnst",
  "description": "Build workspace context selections for LLM prompts and apply structured patch responses back to the project.",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "media/icon.png",
  "preview": true,
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "ai",
    "llm",
    "ai coding",
    "coding assistant",
    "context",
    "context management",
    "workspace context",
    "prompt",
    "prompt context",
    "code context",
    "project context",
    "code patch",
    "patch",
    "ai patch",
    "code editing",
    "developer tools",
    "copilot",
    "claude",
    "chatgpt",
    "gemini"
  ],
  "galleryBanner": {
    "color": "#0F172A",
    "theme": "dark"
  },
  "markdown": "github",
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "media/**",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "contributes": {
  "views": {
    "explorer": [
      {
        "id": "contextBridgeExplorer",
        "name": "Context Bridge",
        "icon": "media/view-icon.svg"
      }
    ]
  },
    "viewsWelcome": [
      {
        "view": "contextBridgeExplorer",
        "contents": "Context Bridge is not initialized yet.\n[Create .vscode/context-bridge.json](command:context-bridge.initializeWorkspaceFiles)",
        "when": "workspaceFolderCount != 0"
      },
      {
        "view": "contextBridgeExplorer",
        "contents": "Open a folder or workspace to use Context Bridge.",
        "when": "workspaceFolderCount == 0"
      }
    ],
    "commands": [
      {
        "command": "context-bridge.initializeWorkspaceFiles",
        "title": "Context Bridge: Initialize Workspace Files",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.createSelection",
        "title": "Context Bridge: Create Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.exportSelection",
        "title": "Context Bridge: Export Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.importSelection",
        "title": "Context Bridge: Import Patch",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.activateSelection",
        "title": "Activate Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.deactivateSelection",
        "title": "Deactivate Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.renameSelection",
        "title": "Rename Selection…",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.deleteSelection",
        "title": "Delete Selection",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.addToSelection",
        "title": "Add to Selection…",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.removeFromSelection",
        "title": "Remove from Selection…",
        "category": "Context Bridge"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "context-bridge.addToSelection",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge@1"
        },
        {
          "command": "context-bridge.removeFromSelection",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge@2"
        }
      ],
      "view/item/context": [
        {
          "command": "context-bridge.createSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.workspaceFolder",
          "group": "1_selection@1"
        },
        {
          "command": "context-bridge.activateSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.inactive",
          "group": "2_state@1"
        },
        {
          "command": "context-bridge.deactivateSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.active",
          "group": "2_state@1"
        },
        {
          "command": "context-bridge.renameSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.active",
          "group": "3_manage@1"
        },
        {
          "command": "context-bridge.renameSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.inactive",
          "group": "3_manage@1"
        },
        {
          "command": "context-bridge.deleteSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.active",
          "group": "3_manage@2"
        },
        {
          "command": "context-bridge.deleteSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.inactive",
          "group": "3_manage@2"
        }
      ]


    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}

