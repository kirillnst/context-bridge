{
  "name": "context-bridge",
  "displayName": "Context Bridge",
  "description": "Build context sets from project files for LLM prompts and apply responses back to the project.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "context-bridge.initializeWorkspaceFiles",
        "title": "Context Bridge: Initialize Workspace Files",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.activateSelection",
        "title": "Активировать выборку",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.deactivateSelection",
        "title": "Деактивировать выборку",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.addToSelection1",
        "title": "Добавить в выборку 1",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.addToSelection2",
        "title": "Добавить в выборку 2",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.addToSelection3",
        "title": "Добавить в выборку 3",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.removeFromSelection1",
        "title": "Убрать из выборки 1",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.removeFromSelection2",
        "title": "Убрать из выборки 2",
        "category": "Context Bridge"
      },
      {
        "command": "context-bridge.removeFromSelection3",
        "title": "Убрать из выборки 3",
        "category": "Context Bridge"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "contextBridgeExplorer",
          "name": "Context Bridge",
          "when": "workspaceFolderCount != 0"
        }
      ]
    },
    "menus": {
      "view/item/context": [
        {
          "command": "context-bridge.activateSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.inactive"
        },
        {
          "command": "context-bridge.deactivateSelection",
          "when": "view == contextBridgeExplorer && viewItem == contextBridge.selection.active"
        }
      ],
      "explorer/context": [
        {
          "command": "context-bridge.addToSelection1",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge_add@1"
        },
        {
          "command": "context-bridge.addToSelection2",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge_add@2"
        },
        {
          "command": "context-bridge.addToSelection3",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge_add@3"
        },
        {
          "command": "context-bridge.removeFromSelection1",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge_remove@1"
        },
        {
          "command": "context-bridge.removeFromSelection2",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge_remove@2"
        },
        {
          "command": "context-bridge.removeFromSelection3",
          "when": "resourceScheme == file && isFileSystemResource",
          "group": "7_contextBridge_remove@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
